#include<stdio.h>
#include<stdlib.h>
int cmp(const void*a,const void* b)
{
    long long x=*(long long *)a;
    long long y=*(long long *)b;
    if(x>y)return 1;
    if(x<y)return -1;
    return 0;
}
int main()
{
    int q;
    scanf("%d",&q);
    while(q--)
    {
        int n;
        scanf("%d",&n);
        long long row[n];
        long long column[n];
        for(int i=0;i<n;i++)
        {
            row[i]=0;
            column[i]=0;
        }
        long long x;
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<n;j++)
        {
            scanf("%lld",&x);
            row[i]+=x;
            column[j]+=x;
        }
        }
        qsort(row,n,sizeof(long long),cmp);
        qsort(column,n,sizeof(long long),cmp);
        int possible=1;
        for(int i=0;i<n;i++)
        {
            if (row[i]!=column[i])
            {
                possible=0;
                break;
            }
        }
        if(possible)
        printf("Possible\n");
        else
        printf("Impossible\n");
}
return 0;
}
