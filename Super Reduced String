#include<stdio.h>
#include<string.h>
int main()
{
    char s[101];
    scanf("%s",s);
    char stack[101];
    int top=-1;
    for(int i=0;s[i]!='\0';i++)
    {
        if(top>=0 && stack[top]==s[i])
        {
            top--;
        }
        else 
        {
            stack[++top]=s[i];
        }
    }
    if(top==-1)
    {
        printf("Empty String\n");
    }
    else 
    {
        for(int i=0;i<=top;i++)
        {
            printf("%c",stack[i]);
        }
        printf("\n");
    }
    return 0;
}
