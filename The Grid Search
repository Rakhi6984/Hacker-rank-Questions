#include<stdio.h>
#include<string.h>
int main()
{
    int t;
    scanf("%d",&t);
    while(t--)
    {
        int R,C;
        scanf("%d%d",&R,&C);
        char G[R][C+1];
        for(int i=0;i<R;i++)
        scanf("%s",G[i]);
        int r,c;
        scanf("%d%d",&r,&c);
        char P[r][c+1];
        for(int i=0;i<r;i++)
        scanf("%s",P[i]);
        int found=0;
        for(int i=0;i<=R-r &&! found;i++)
        {
            for(int j=0;j<=C-c;j++)
            {
                int match=1;
                for(int k=0;k<r;k++)
                {
                    if(strncmp(&G[i+k][j],P[k],c)!=0)
                    {
                        match=0;
                        break;
                    }
                }
                if(match)
                {
                found=1;
                break;
            }
        }
        }
        if(found)
        printf("YES\n");
        else 
        printf("NO\n");
        }
        return 0;
}
