#include<stdio.h>
int main()
{
    int n;
    scanf("%d", &n);
    int arr[n];
    int freq[6] = {0};
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
        freq[arr[i]]++;
    }
    int maxfreq = 0;
    int result = 1;
    for (int i =1; i <= 5; i++)
    {
        if (freq[i] > maxfreq)
        {
            maxfreq = freq[i];
            result = i;
        }
    }
    printf("%d\n", result);
    return 0;
}
