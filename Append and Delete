#include<stdio.h>
#include<string.h>
int main()
{
    char s[100],t[100];
    int k,i=0;
    scanf("%s",s);
    scanf("%s",t);
    scanf("%d",&k);
    while(s[i]==t[i]&&s[i]!='\0'&&t[i]!='0')
    i++;
    int need=(strlen(s)-i)+(strlen(t)-i);
    if(k>=need&&((k-need)%2==0||k>strlen(s)+strlen(t)))
    printf("Yes");
    else 
    printf("No");
    return 0;
}
