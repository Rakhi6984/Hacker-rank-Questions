#include <stdio.h>
#include <stdlib.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))


long candies(int n, int* arr) {
    long* candies = (long*)malloc(n * sizeof(long));
    
    
    for (int i = 0; i < n; i++) {
        candies[i] = 1;
    }
    
    
    for (int i = 1; i < n; i++) {
        if (arr[i] > arr[i - 1]) {
            candies[i] = candies[i - 1] + 1;
        }
    }
    
    
    for (int i = n - 2; i >= 0; i--) {
        if (arr[i] > arr[i + 1]) {
            candies[i] = MAX(candies[i], candies[i + 1] + 1);
        }
    }
    

    long total_candies = 0;
    for (int i = 0; i < n; i++) {
        total_candies += candies[i];
    }
    
    free(candies);
    return total_candies;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    

    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    long result = candies(n, arr);
    
    
    printf("%ld\n", result);
    
    free(arr);
    return 0;
}
