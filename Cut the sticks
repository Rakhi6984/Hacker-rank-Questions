#include<stdio.h>
#include<stdlib.h>
int compare(const void*a,const void*b)
{
    return (*(int *)a-*(int *)b);
}
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    qsort(arr,n,sizeof(int),compare);
    int count =n;
    int i=0;
    while(count>0)
    {
        printf("%d\n",count);
        int cut=arr[i];
        while(i<n && arr[i]==cut)
        {
        i++;
        count--;
        }
    }
        return 0;
}
