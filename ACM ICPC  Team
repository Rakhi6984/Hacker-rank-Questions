#include<stdio.h>
#include<string.h>
int main()
{
    int n,m;
    scanf("%d%d",&n,&m);
    char topics[n][m+1];
    for(int i=0;i<n;i++)
    {
        scanf("%s",topics[i]);
    }
    int maxcount=0;
    int teamcount=0;
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            int knowntopics=0;
            for(int k=0;k<m;k++)
            {
                if (topics[i][k]=='1'||topics[j][k]=='1')
                {
                    knowntopics++;
                }
                if(knowntopics>maxcount)
                {
                    maxcount=knowntopics;
                    teamcount=1;
                }
                else if(knowntopics==maxcount)
                {
                    teamcount++;
                }
            }
        }
    }
    printf("%d\n",maxcount);
    printf("%d\n",teamcount);
    return 0;
}
