#include<stdio.h>
#include<stdlib.h>
int compare(const void *a, const void *b)
{
    long long arg1 = *(const int *)a;
    long long arg2 = *(const int *)b;
    if (arg1 < arg2)
    return -1;
    if (arg1 > arg2) 
    return 1;
    return 0;
}
int main()
{
    int n;
    if (scanf("%d", &n) != 1)
    return 0;
    int sticks[n];
    for (int i=0;i<n;i++)
    {
      scanf("%d", &sticks[i]);  
    }
    qsort(sticks, n, sizeof(int), compare);
    for (int i = n -3; i >=0;i--)
    {
        if((long long) sticks[i] + sticks[i+1] > sticks[i+2])
        {
            printf("%d %d %d\n", sticks[i], sticks[i+1], sticks[i+2]);
            return 0;
        }
    }
    printf("-1\n");
    return 0;
}
