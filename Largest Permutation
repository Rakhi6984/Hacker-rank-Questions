#include <stdio.h>
#include <stdlib.h>

void largestPermutation(int k, int arr_count, int* arr) {
    int *pos = (int *)malloc((arr_count + 1) * sizeof(int));
    for (int i = 0; i < arr_count; i++) {
        pos[arr[i]] = i;
    }

    for (int i = 0; i < arr_count && k > 0; i++) {
        int expected = arr_count - i;
        if (arr[i] != expected) {
            int current_val = arr[i];
            int swap_idx = pos[expected];

        
            arr[i] = expected;
            arr[swap_idx] = current_val;

        
            pos[expected] = i;
            pos[current_val] = swap_idx;


            k--;
        }
    }

    free(pos);
}

int main() {
    int n, k;
    if (scanf("%d %d", &n, &k) != 2) return 0;

    int *arr = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    largestPermutation(k, n, arr);

    // Print the result
    for (int i = 0; i < n; i++) {
        printf("%d%c", arr[i], (i == n - 1) ? '\n' : ' ');
    }

    free(arr);
    return 0;
}
