#include<stdio.h>
int main()
{
    int m,n,r;
    scanf("%d%d%d",&m,&n,&r);
    int a[300][300];
    for(int i=0;i<m;i++)
        for(int j=0;j<n;j++)
        scanf("%d",&a[i][j]);
         int layers=(m<n?m:n)/2;
        for(int l=0;l<layers;l++)
        {
            int temp[10000],k=0;
            int top=l;
            int left=l;
            int bottom=m-l-1;
            int right=n-l-1;
            for(int j=left;j<right;j++)
     temp[k++]=a[top][j];
            for(int i=top;i<bottom;i++)
        temp[k++]=a[i][right];
            for(int j=right;j>left;j--)
            temp[k++]=a[bottom][j];
            for(int i=bottom;i>top;i--)
            temp[k++]=a[i][left];
            int len=k;
            int rot=r%len;
            int idx=rot;
            for(int j=left;j<right;j++)
            a[top][j]=temp[idx++%len];
            for(int i=top;i<bottom;i++)
            a[i][right]=temp[idx++%len];
            for(int j=right;j>left;j--)
            a[bottom][j]=temp[idx++%len];
            for(int i=bottom;i>top;i--)
            a[i][left]=temp[idx++%len];
        }
        for(int i=0;i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                printf("%d",a[i][j]);
                if(j<n-1) printf(" ");
            }
            printf("\n");
        }
    return 0;
}
