#include<stdio.h>
#include<string.h>
typedef struct
{
    int area;
    int cells[225][2];
    int cnt;
    }
    Plus;
    int overlap(Plus a,Plus b)
    {
        for(int i=0;i<a.cnt;i++)
        {
            for(int j=0;j<b.cnt;j++)
            {
                if(a.cells[i][0]==b.cells[j][0] &&
                a.cells[i][1]==b.cells[j][1])
                return 1;
            }
        }
        return 0;
    }
    int main()
    {
        int n,m;
        scanf("%d%d",&n,&m);
        char grid[15][15];
        for(int i=0;i<n;i++)
        {
            scanf("%s",grid[i]);
        }
        Plus pluses[1000];
        int pcount=0;
        for(int r=0;r<n;r++)
        {
            for(int c=0;c<m;c++)
            {
                if(grid[r][c]!='G')
                continue;
                int k=0;
                while(1)
                {
                    if(r-k<0||r+k>=n||
                    c-k<0||c+k>=m)break;
                    if(grid[r-k][c]!='G'||
                    grid[r+k][c]!='G'||
                    grid[r][c-k]!='G'||
                    grid[r][c+k]!='G')
                    break;
                    Plus p;
                    p.cnt=0;
                    p.cells[p.cnt][0]=r;
                    p.cells[p.cnt][1]=c;
                    p.cnt++;
                    for(int t=1;t<=k;t++)
                    {
                        p.cells[p.cnt][0]=r+t;
                        p.cells[p.cnt][1]=c;
                        p.cnt++;
                        p.cells[p.cnt][0]=r-t;
                        p.cells[p.cnt][1]=c;
                        p.cnt++;
                        p.cells[p.cnt][0]=r;
                        p.cells[p.cnt][1]=c+t;
                        p.cnt++;
                        p.cells[p.cnt][0]=r;
                        p.cells[p.cnt][1]=c-t;
                        p.cnt++;
                    }
                    p.area=1+4*k;
                    pluses[pcount++]=p;
                    k++;
                }
            }
        }
        int ans=0;
        for(int i=0;i<pcount;i++)
        {
            for(int j=i+1;j<pcount;j++)
            {
                if(!overlap(pluses[i],pluses[j]))
                {
                    int product=pluses[i].area*pluses[j].area;
                    if(product>ans)
                    ans=product;
            }
            }
        }
        printf("%d\n",ans);
        return 0;
    }
