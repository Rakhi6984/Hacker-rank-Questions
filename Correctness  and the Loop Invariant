#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    for(int i=1;i<n;i++)
    {
        int value=arr[i];
        int j=i-1;
        while(j>=0 && arr[j]>value)
        {
            arr[j+1]=arr[j];
            j--;
        }
        arr[j+1]=value;
    }
    for(int i=0;i<n;i++)
    {
        printf("%d",arr[i]);
        if(i<n-1)
        printf(" ");
    }
    printf("\n");
    return 0;
}
