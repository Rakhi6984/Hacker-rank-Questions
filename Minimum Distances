#include<stdio.h>
int minimumDistances(int arr_count,int*arr)
{
    int min=100000;
    for(int i=0;i<arr_count;i++)
    {
      for(int j=i+1;j<arr_count;j++)
      {
        if(arr[i]==arr[j])
        {
            if(j-i<min)
            min=j-i;
        }
      }  
    }
    if(min==100000)
    return -1;
    
    return min;
}
int main()
{
    int n; 
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    printf("%d\n",minimumDistances(n,arr));
    return 0;
}
