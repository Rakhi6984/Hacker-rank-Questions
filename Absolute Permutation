#include<stdio.h>
int main()
{
    int t;
    scanf("%d",&t);
    while(t--)
    {
        int n,k;
        scanf("%d%d",&n,&k);
        if(k==0)
        {
            for(int i=1;i<=n;i++)
            {
                printf("%d",i);
                if(i<n)printf(" ");
            }
            printf("\n");
        }
        else if(n%(2*k)==0)
        {
            int add=1;
            for(int i=1;i<=n;i++)
            {
                if(add)
                printf("%d",i+k);
                else 
                printf("%d",i-k);
                if(i<n)printf(" ");
                 if(i%k==0)
                 add=!add;
            }
            printf("\n");
        }
        else 
        {
            printf("-1\n");
        }
        }
return 0;
}
