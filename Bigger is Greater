#include<stdio.h>
#include<string.h>
int main()
{
    int t;
    scanf("%d",&t);
    while(t--)
    {
        char w[10001];
        scanf("%s",w);
        int n=strlen(w);
        int i =n-2;
        while(i>=0 && w[i]>=w[i+1])
        i--;
        if(i<0)
        {
            printf("no answer\n");
            continue;
        }
        int j=n-1;
        while(w[j]<=w[i])
        j--;
        char temp=w[i];
        w[i]=w[j];
        w[j]=temp;
        int left=i+1,right=n-1;
        while(left<right)
        {
            temp=w[left];
            w[left]=w[right];
            w[right]=temp;
            left++;
            right--;
        }
        printf("%s\n",w);
    }
    return 0;
}
