#include<stdio.h>
int main()
{
    int H,W;
    scanf("%d%d",&H,&W);
    int A[100][100];
    for(int i=0;i<H;i++)
    {
        for(int j=0;j<W;j++)
        {
            scanf("%d",&A[i][j]);
        }
    }
    int area=0;
    for(int i=0;i<H;i++)
    {
        for(int j=0;j<W;j++)
        {
            if(A[i][j]>0)
            {
                area+=2;
                int up=(i==0)?0:A[i-1][j];
                int down=(i==H-1)?0:A[i+1][j];
                int left=(j==0)?0:A[i][j-1];
                int right=(j==W-1)?0:A[i][j+1];
                area+=(A[i][j]>up)?A[i][j]-up:0;
                area+=(A[i][j]>down)?A[i][j]-down:0;
                area+=(A[i][j]>left)?A[i][j]-left:0;
                area+=(A[i][j]>right)?A[i][j]-right:0;
                
            }
        }
    }
    printf("%d\n",area);
    return 0;
}
