#include<stdio.h>
#include<string.h>
#include<ctype.h>
int minimumNumber(int n,char password[])
{
    int hasDigit=0,hasLower=0,hasUpper=0,hasSpecial=0;
    char special[]="!@#$%^&*()-+";
    for(int i=0;password[i];i++)
    {
        if(password[i]>='0' && password[i]<='9')
        hasDigit=1;
        else if(password[i]>='a' && password[i]<='z')
        hasLower=1;
        else if(password[i]>='A' &&password[i]<='Z')
        hasUpper=1;
        else 
        hasSpecial=1;
        }
        int missing=(1-hasDigit)+(1-hasLower)+(1-hasUpper)+(1-hasSpecial);
        return(missing>6-n)?missing:6-n;
}
int main()
{
    int n;
    char password[101];
    scanf("%d",&n);
    scanf("%s",password);
    printf("%d\n",minimumNumber(n,password));
