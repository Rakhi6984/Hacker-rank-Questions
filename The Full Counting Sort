#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#define MAX_VAL 100
typedef struct Node
{
    char *str;
    struct Node*next;
} Node;
int main()
{
    int n;
    if(scanf("%d", &n)!=1) return 0;
    Node *heads[MAX_VAL]= {NULL};
    Node *tails[MAX_VAL]={NULL};
    int half =n/2;
    for(int i=0;i<n;i++)
    {
        int val;
        char buffer[12];
        scanf("%d %s", &val, buffer);
        char *s;
        if(i<half)
        {
            s=malloc(2);
            strcpy(s,"-");
        }
        else 
        {
            s=malloc(strlen(buffer)+1);
            strcpy(s, buffer);
        }
        Node *newNode=malloc(sizeof(Node));
        newNode->str=s;
        newNode->next=NULL;
        if(heads[val]==NULL)
        {
            heads[val]=newNode;
            tails[val]= newNode;
        }
        else 
        {
            tails[val]->next=newNode;
            tails[val]= newNode;
        }
    }
    int first=1;
    for(int i=0;i<MAX_VAL;i++)
    {
       Node *curr =heads[i];
       while(curr!=NULL)
       {
        if(!first)
        {
            putchar(' ');
        }
        fputs(curr->str, stdout);
        first=0;
        Node *temp=curr;
        curr=curr->next;
        free(temp->str);
        free(temp);
       } 
    }
    putchar('\n');
    return 0;
}
