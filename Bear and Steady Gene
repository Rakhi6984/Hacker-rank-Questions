#include<stdio.h>
#include<stdlib.h>
#include<string.h>
int get_index(char c)
{
    switch(c) 
    {
        case 'A': return 0;
        case 'C': return 1;
        case 'G': return 2;
        case 'T': return 3;
        default: return -1;
    }
}
int steadyGene(char* gene)
{
    int n = strlen(gene);
    int limit = n / 4;
    int count[4] = {0};
    for (int i= 0;i<n;i++)
    {
        count[get_index(gene[i])]++;
    }
    if (count[0] == limit && count[1] == limit && count[2] == limit && count[3] == limit)
    {
        return 0;
    }
    int min_length = n;
    int left = 0;
    for (int right = 0;right <n;right++)
    {
        count[get_index(gene[right])]--;
        while(left <= right && count[0] <= limit && count[1] <= limit && count[2] <= limit && count[3] <= limit)
        {
            int current_length = right -left +1;
            if(current_length < min_length)
            {
                min_length = current_length;
            }
            count[get_index(gene[left])]++;
            left++;
        }
    }
    return min_length;
}
int main()
{
    int n;
    if (scanf("%d", &n) != 1) return 0;
    char* gene = (char*)malloc((n+1) * sizeof(char));
    scanf("%s", gene);
    printf("%d\n", steadyGene(gene));
    free(gene);
    return 0;
}
