#include <stdio.h>
#include <stdlib.h>

int* missingNumbers(int arr_count, int* arr, int brr_count, int* brr, int* result_count) {
    int min_val = brr[0];
    for (int i = 1; i < brr_count; i++) {
        if (brr[i] < min_val) {
            min_val = brr[i];
        }
    }
    
    int freq[101] = {0};
    
    for (int i = 0; i < brr_count; i++) {
        freq[brr[i] - min_val]++;
    }
    
    for (int i = 0; i < arr_count; i++) {
        freq[arr[i] - min_val]--;
    }
    
    int count = 0;
    for (int i = 0; i <= 100; i++) {
        if (freq[i] > 0) {
            count++;
        }
    }
    
    *result_count = count;
    int* result = malloc(count * sizeof(int));
    
    int idx = 0;
    for (int i = 0; i <= 100; i++) {
        if (freq[i] > 0) {
            result[idx++] = i + min_val;
        }
    }
    
    return result;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    int* arr = malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    int m;
    scanf("%d", &m);
    
    int* brr = malloc(m * sizeof(int));
    for (int i = 0; i < m; i++) {
        scanf("%d", &brr[i]);
    }
    
    int result_count = 0;
    int* result = missingNumbers(n, arr, m, brr, &result_count);
    
    for (int i = 0; i < result_count; i++) {
        printf("%d%s", result[i], (i == result_count - 1) ? "" : " ");
    }
    printf("\n");
    
    free(arr);
    free(brr);
    free(result);
    
    return 0;
}
