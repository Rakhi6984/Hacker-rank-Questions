#include<stdio.h>
int main()
{
    int t;
    scanf("%d",&t);
    while(t--)
    {
    int n,k;
    scanf("%d%d",&n,&k);
    int count=0;
    for(int i=0;i<n;i++)
    {
        int arrival;
        scanf("%d",&arrival);
        if(arrival<=0)
        count++;
    }
    if(count<k)
    printf("YES\n");
    else 
    printf("NO\n");
    }
    return 0;
}
