#include <stdio.h>
#include <stdlib.h>
typedef struct {
    int val;
    int index;
} Element;
int compareAsc(const void *a, const void *b) {
    Element *el1 = (Element *)a;
    Element *el2 = (Element *)b;
    if (el1->val < el2->val) return -1;
    if (el1->val > el2->val) return 1;
    return 0;
}
int compareDesc(const void *a, const void *b) {
    Element *el1 = (Element *)a;
    Element *el2 = (Element *)b;
    if (el1->val > el2->val) return -1;
    if (el1->val < el2->val) return 1;
    return 0;
}

long long getSwaps(int *arr, int n, int ascending) {
    Element *sorted = (Element *)malloc(n * sizeof(Element));
    for (int i = 0; i < n; i++) {
        sorted[i].val = arr[i];
        sorted[i].index = i;
    }

    if (ascending) {
        qsort(sorted, n, sizeof(Element), compareAsc);
    } else {
        qsort(sorted, n, sizeof(Element), compareDesc);
    }

    int *visited = (int *)calloc(n, sizeof(int));
    long long swaps = 0;

    for (int i = 0; i < n; i++) {
        if (visited[i] || sorted[i].index == i) {
            continue;
        }
        long long cycle_size = 0;
        int j = i;
        while (!visited[j]) {
            visited[j] = 1;
            j = sorted[j].index;
            cycle_size++;
        }

        if (cycle_size > 0) {
            swaps += (cycle_size - 1);
        }
    }

    free(sorted);
    free(visited);
    return swaps;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int *arr = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    long long swapsAsc = getSwaps(arr, n, 1);
    long long swapsDesc = getSwaps(arr, n, 0);
    long long minSwaps = (swapsAsc < swapsDesc) ? swapsAsc : swapsDesc;
    printf("%lld\n", minSwaps);

    free(arr);
    return 0;
}
