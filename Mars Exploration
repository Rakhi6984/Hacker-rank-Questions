#include<stdio.h>
#include<string.h>
int main()
{
    char s[1001];
    scanf("%s",s);
    int count=0;
    for(int i=0;s[i]!='\0';i++)
    {
       if(i%3==0 && s[i]!='S')
       count++;
       else if(i%3==1 && s[i]!='O')
       count++;
       else if(i%3==2 && s[i]!='S')
       count++; 
 }
 printf("%d",count);
 return 0;
}
