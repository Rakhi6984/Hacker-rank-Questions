#include<stdio.h>
int main()
{
    int q;
    scanf("%d",&q);
    while(q--)
    {
        int a,b;
        scanf("%d%d",&a,&b);
        int start=(int)ceil(sqrt(a));
        int end=(int)floor(sqrt(b));
        int count=end-start+1;
        if(count<0)
        count=0;
        printf("%d\n",count);
    }
    return 0;
}
