#include<stdio.h>
#include<string.h>
int gemstones(int n,char arr[][101])
{
    int count=0;
    for(char ch='a';ch<='z';ch++)
    {
        int found=1;
        for(int i=0;i<n;i++)
        {
            if(strchr(arr[i],ch)==NULL)
            {
                found=0;
                break;
            }
        }
        if(found)
        count++;
    }
    return count;
}
int main()
{
    int n;
    scanf("%d",&n);
    char arr[n][101];
    for(int i=0;i<n;i++)
    scanf("%s",arr[i]);
    printf("%d\n",gemstones(n,arr));
    return 0;
}
