#include<stdio.h>
#include<stdlib.h>
int cmp(const void*a,const void*b)
{
    int x=*(int *)a;
    int y=*(int *)b;
    if(x<y)return -1;
    if(x>y)return 1;
    return 0;
}
int main()
{
    int n;
    scanf("%d",&n);
    int arr[100000];
    int sorted[100000];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
        sorted[i]=arr[i];
    }
    qsort(sorted,n,sizeof(int),cmp);
    int l=-1,r=-1;
    for(int i=0;i<n;i++)
    {
        if(arr[i]!=sorted[i])
        {
            if(l==-1) 
            l=i;
            r=i;
        }
    }
    if(l==-1)
    {
        printf("yes\n");
        return 0;
    }
    int temp=arr[l];
    arr[l]=arr[r];
    arr[r]=temp;
    int ok=1;
    for(int i=0;i<n;i++)
    {
        if(arr[i]!=sorted[i])
        {
            ok=0;
            break;
        }
    }
    if(ok)
    {
        printf("yes\n");
        printf("swap %d %d\n",l+1,r+1);
        return 0;
    }
    temp=arr[l];
    arr[l]=arr[r];
    arr[r]=temp;
    int left=l,right=r;
    while(left<right)
    {
        temp=arr[left];
        arr[left]=arr[right];
        arr[right]=temp;
        left++;
        right--;
    }
    ok=1;
    for(int i=0;i<n;i++)
    {
        if(arr[i]!=sorted[i])
        {
            ok=0;
            break;
        }
    }
    if(ok)
    {
        printf("yes\n");
        printf("reverse %d %d\n", l+1, r+1);
    }
    else 
    {
        printf("no\n");
    }
    return 0;
}
