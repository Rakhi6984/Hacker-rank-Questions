#include<stdio.h>
#include<string.h>
#include<math.h>
int main()
{
    char s[100];
    scanf("%s",s);
    int len=strlen(s);
    int rows=floor(sqrt(len));
    int cols=ceil(sqrt(len));
    if(rows * cols<len)
    rows++;
    for(int c=0;c<cols;c++)
    {
        for(int i=c;i<len;i+=cols)
        {
            printf("%c",s[i]);
        }
        printf(" ");
    }
    return 0;
}
