#include<stdio.h>
#include<stdlib.h>
int*quickSort(int arr_count,int*arr,int*result_count)
{
    int*result=(int*)malloc(arr_count*sizeof(int));int pivot=arr[0];
    int k=0;
    for(int i=0;i<arr_count;i++)
    {
        if(arr[i]<pivot)
        {
            result[k++]=arr[i];
        }
    }
    result[k++]=pivot;
    for(int i=0;i<arr_count;i++)
    {
        if(arr[i]>pivot)
        {
            result[k++]=arr[i];
        }
    }
    *result_count=arr_count;
    return result;
}
int main()
{
    int n;
    scanf("%d",&n);
    int*arr=(int*)malloc(n*sizeof(int));
    for(int i=0;i<n;i++)
    scanf("%d",&arr[i]);
    int result_count;
    int*result=quickSort(n,arr,&result_count);
    for(int i=0;i<result_count;i++)
    {
    printf("%d", result[i]);
    if(i!=result_count-1)
    printf(" ");
    }
    printf("\n");
    free(arr);
    free(result);
    return 0;
}









