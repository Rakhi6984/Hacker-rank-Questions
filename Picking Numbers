#include<stdio.h>
int pickingnumbers(int a[], int n)
{
    int freq[101] = {0};
    for (int i = 0; i < n; i++)
    {
        freq[a[i]]++;
    }
    int maxlen = 0;
    for (int i = 0; i < 100; i++)
    {
        int len = freq[i] + freq[i + 1];
        if (len > maxlen)
        {
            maxlen = len;
        }
    }
    return maxlen;
}
int main()
{
    int n ;
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i< n; i++)
    {
        scanf("%d", &arr[i]);
    }
    printf("%d\n", pickingnumbers(arr, n));
    return 0;
}
