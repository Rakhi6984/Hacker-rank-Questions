#include<stdio.h>
#include<string.h>
int beautifulBinaryString(char *b)
{
    int count=0;
    int n=strlen(b);
    for(int i=0;i<=n-3;i++)
    {
        if(b[i]=='0' && b[i+1]=='1' && b[i+2]=='0')
        {
            count++;
            i+=2;
        }
    }
    return count;
}
int main()
{
    int n;
    scanf("%d",&n);
    char b[100005];
    scanf("%s",b);
    printf("%d\n",beautifulBinaryString(b));
    return 0;
}
