#include<stdio.h>
#include<string.h>
#include<stdlib.h>
void separateNumbers(char*s)
{
    int n=strlen(s);
    if(n==1||s[0]=='0')
    {
        printf("NO\n");
        return ;
    }
    for(int len=1;len<=n/2;len++)
    {
        char first[20];
        strncpy(first,s,len);
        first[len]='\0';
        long long num=atoll(first);
        long long start=num;
        char temp[100];
        temp[0]='\0';
        while(strlen (temp)<n)
        {
            char buf[20];
            sprintf(buf,"%lld",num);
            strcat(temp,buf);
            num++;
        }
        if(strcmp(temp,s)==0)
        {
            printf("YES %lld\n",start);
            return;
        }
    }
    printf("NO\n");
}
int main()
{
    int q;
    scanf("%d",&q);
    while(q--)
    {
        char s[100];
        scanf("%s",s);
        separateNumbers(s);
    }
    return 0;
}
