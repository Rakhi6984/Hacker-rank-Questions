#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXLEN 100005
#define ALPHABET_SIZE 26

typedef struct State {
    int len;
    int link;
    int next[ALPHABET_SIZE];
    long long occ;
} State;

State st[MAXLEN * 2];
int sz, last;

void sam_init() {
    st[0].len = 0;
    st[0].link = -1;
    st[0].occ = 0;
    memset(st[0].next, -1, sizeof(st[0].next));
    sz = 1;
    last = 0;
}

void sam_extend(char c) {
    int cur = sz++;
    st[cur].len = st[last].len + 1;
    st[cur].occ = 1; 
    memset(st[cur].next, -1, sizeof(st[cur].next));

    int p = last;
    while (p != -1 && st[p].next[c - 'a'] == -1) {
        st[p].next[c - 'a'] = cur;
        p = st[p].link;
    }

    if (p == -1) {
        st[cur].link = 0;
    } else {
        int q = st[p].next[c - 'a'];
        if (st[p].len + 1 == st[q].len) {
            st[cur].link = q;
        } else {
            int clone = sz++;
            st[clone].len = st[p].len + 1;
            memcpy(st[clone].next, st[q].next, sizeof(st[q].next));
            st[clone].link = st[q].link;
            st[clone].occ = 0; 

            while (p != -1 && st[p].next[c - 'a'] == q) {
                st[p].next[c - 'a'] = clone;
                p = st[p].link;
            }
            st[q].link = st[cur].link = clone;
        }
    }
    last = cur;
}

int main() {
    static char str[MAXLEN];
    if (scanf("%s", str) != 1) return 0;

    int n = strlen(str);
    sam_init();

    for (int i = 0; i < n; i++) {
        sam_extend(str[i]);
    }


    int* cnt = (int*)calloc(n + 1, sizeof(int));
    int* order = (int*)malloc(sz * sizeof(int));

    for (int i = 0; i < sz; i++) cnt[st[i].len]++;
    for (int i = 1; i <= n; i++) cnt[i] += cnt[i - 1];
    for (int i = 0; i < sz; i++) order[--cnt[st[i].len]] = i;

    
    for (int i = sz - 1; i > 0; i--) {
        int u = order[i];
        if (st[u].link != -1) {
            st[st[u].link].occ += st[u].occ;
        }
    }


    long long max_val = 0;
    for (int i = 1; i < sz; i++) {
        long long val = (long long)st[i].len * st[i].occ;
        if (val > max_val) {
            max_val = val;
        }
    }

    printf("%lld\n", max_val);

    free(cnt);
    free(order);
    return 0;
}
