#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int grade;
    for(int i=0;i<n;i++)
    {
        scanf("%d",&grade);
        if(grade>=38)
        {
            int nextmultiple=((grade/5)+1)*5;
            if(nextmultiple-grade<3)
            {
                grade=nextmultiple;
            }
        }
        printf("%d\n", grade);
    }
    return 0;
}
