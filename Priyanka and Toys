#include<stdio.h>
#include<stdlib.h>
int compare(const void *a, const void *b)
{
    return (*(int *)a - *(int*)b);
}
int toys(int w_count, int* w)
{
    qsort(w, w_count, sizeof(int), compare);
    int containers = 0;
    int i=0;
    while(i< w_count)
    {
        containers++;
        int min_weight = w[i];
        while (i< w_count && w[i] <= min_weight + 4)
        {
            i++;
        }
    }
    return containers;
}
int main()
{
    int n;
    if (scanf("%d", &n) != 1)
    return 0;
    int *w = (int*)malloc(n* sizeof(int));
    for(int i =0;i<n;i++)
    {
        scanf("%d", &w[i]);
    }
    int result = toys(n, w);
    printf("%d\n", result);
    free(w);
    return 0;
}
