#include<stdio.h>
#include<string.h>
#include<stdlib.h>
int anagram(char* s)
{
    int len = strlen(s);
    if (len %2 != 0)
    {
        return -1;
    }
    int mid = len / 2;
    int count1[26] = {0};
    int count2[26] = {0};
    for (int i = 0; i < mid;i++)
    {
        count1[s[i]-'a']++;
        count2[s[i+ mid]-'a']++;
    }
    int changes = 0;
     for (int i =0;i<26;i++)
     {
        if(count1[i]> count2[i])
        {
            changes += (count1[i] - count2[i]);
        }
     }
     return changes;
}
int main()
{
    int q;
    if(scanf("%d", &q)!= 1)
    return 0;
    while(q--)
    {
        char s[10005];
        scanf("%s", s);
        printf("%d\n", anagram(s));
    }
    return 0;
}
