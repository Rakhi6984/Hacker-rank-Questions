#include<stdio.h>
int main()
{
    int s, t;
    scanf("%d %d",&s, &t);
    int a, b;
    scanf("%d %d", &a, &b);
    int m, n;
    scanf("%d %d",&m, &n);
    int apple=0,orange=0;
    int d;
    for(int i=0; i<m; i++)
    {
        scanf("%d", &d);
        if(a+d >=s && a+d <=t)
        apple++;
    }
    for(int i=0; i<n; i++)
    {
        scanf("%d",&d);
        if(b+d >=s && b+d <=t)
        orange++;
    }
    printf("%d\n", apple);
    printf("%d\n", orange);
    return 0;
}
