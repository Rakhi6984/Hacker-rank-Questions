#include<stdio.h>
#include<string.h>
#include<stdlib.h>
char* isValid(char* s)
{
    int freq[26] = {0};
    for(int i =0;s[i]!= '\0';i++)
    {
        freq[s[i]- 'a']++;
    }
    int count[100005] = {0};
    int distinct_freqs[2] = {0};
    int distinct_counts[2] = {0};
    int num_distinct = 0;
    for (int i = 0;i<26;i++)
    {
        if(freq[i] > 0)
        {
            int f = freq[i];
            int found = 0;
            for(int j=0;j<num_distinct;j++)
            {
                if(distinct_freqs[j]== f)
                {
                    distinct_counts[j]++;
                    found = 1;
                    break;
                }
            }
            if (!found)
            {
                if (num_distinct>=2)
                {
                    return "NO";
                }
                distinct_freqs[num_distinct] = f;
                distinct_counts[num_distinct] = 1;
                num_distinct++;
            }
        }
    }
    if (num_distinct ==1)
    {
        return "YES";
    }
    if (num_distinct ==2)
    {
        int f1 = distinct_freqs[0], c1 = distinct_counts[0];
        int f2 = distinct_freqs[1], c2 = distinct_counts[1];
        if ((f1 == 1 && c1 == 1) || (f2 == 1 && c2 == 1))
        {
            return "YES";
        }
        if ((abs(f1 - f2) == 1) && ((f1 > f2 && c1 == 1) || (f2 > f1 && c2 == 1))) 
        {
            return "YES";
        }
    }
    return "NO";
}
int main()
{
    char s[100005];
    if (scanf("%s", s) == 1)
    {
        printf("%s\n", isValid(s));
    }
    return 0;
}
