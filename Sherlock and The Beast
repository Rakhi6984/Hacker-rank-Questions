#include <stdio.h>

void decentNumber(int n) {
    int fives = n;

    while (fives % 3 != 0) {
        fives -= 5;
    }
    if (fives < 0) {
        printf("-1\n");
    } else {
        int threes = n - fives;
        
    
        for (int i = 0; i < fives; i++) {
            putchar('5');
        }
        
        for(int i = 0; i < threes; i++) {
            putchar('3');
        }
        putchar('\n');
    }
}

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    
    while (t--) {
        int n;
        scanf("%d", &n);
        decentNumber(n);
    }
    
    return 0;
}
