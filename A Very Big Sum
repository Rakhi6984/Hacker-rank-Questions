#include<stdio.h>
long long aVeryBigSum(long long ar[],int n)
{
    long long sum=0;
    for(int i=0;i<n;i++)
    {
        sum+=ar[i];
    }
    return sum;
}
int main()
{
    int n;
    scanf("%d",&n);
    long long ar[n];
    long long sum=0;
    for(int i=0;i<n;i++)
    {
        scanf("%lld",&ar[i]);
        sum+=ar[i];
}
    printf("%lld",sum);
    return 0;
}
