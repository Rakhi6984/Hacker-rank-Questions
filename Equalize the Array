#include<stdio.h>
int equalizeArray(int arr_count,int*arr)
{
    int freq[101]={0};
    int maxfreq=0;
    for(int i=0;i<arr_count;i++)
    {
        freq[arr[i]]++;
        if (freq[arr[i]]>maxfreq)
        maxfreq=freq[arr[i]];
    }
    return arr_count-maxfreq;
}
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    } 
    printf("%d\n",equalizeArray(n,arr));
    return 0;
}
