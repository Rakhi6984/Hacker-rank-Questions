#include <stdio.h>
#include <string.h>

char* twoStrings(char* s1, char* s2)
{
    int char_set[26] = {0}; 
    for (int i = 0; s1[i] != '\0'; i++)
    {
        char_set[s1[i] - 'a'] = 1;
    }
    
    for (int i = 0; s2[i] != '\0'; i++)
    {
        if (char_set[s2[i] - 'a'] == 1)
        {
            return "YES";
        }
    }
    
    return "NO";
}

int main()
{
    int q;
    if (scanf("%d", &q) != 1) return 0;
    
    while (q--)
    {
        char s1[100005], s2[100005];
        scanf("%s", s1);
        scanf("%s", s2);
        
        char* result = twoStrings(s1, s2);
        printf("%s\n", result);
    }
    
    return 0;
}
