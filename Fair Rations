#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int b[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&b[i]);
    }
    int count=0;
    for(int i=0;i<n-1;i++)
    {
        if(b[i]%2!=0)
        {
            b[i]++;
            b[i+1]++;
            count+=2;
        }
    }
    if(b[n-1]%2!=0)
    printf("NO\n");
    else 
    printf("%d\n",count);
    return 0;
}
