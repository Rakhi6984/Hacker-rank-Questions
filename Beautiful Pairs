#include <stdio.h>
#include <stdlib.h>

int beautifulPairs(int n, int* A, int* B) {
    
    int countA[1001] = {0};
    int countB[1001] = {0};
    
    for (int i = 0; i < n; i++) {
        countA[A[i]]++;
        countB[B[i]]++;
    }
    
    
    int matching_pairs = 0;
    for (int i = 1; i <= 1000; i++) {
        matching_pairs += (countA[i] < countB[i]) ? countA[i] : countB[i];
    }
    

    if (matching_pairs < n) {
        return matching_pairs + 1;
    } else {
        return matching_pairs - 1;
    }
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    int* A = (int*)malloc(n * sizeof(int));
    int* B = (int*)malloc(n * sizeof(int));
    
    for (int i = 0; i < n; i++) scanf("%d", &A[i]);
    for (int i = 0; i < n; i++) scanf("%d", &B[i]);
    
    int result = beautifulPairs(n, A, B);
    printf("%d\n", result);
    
    free(A);
    free(B);
    return 0;
}
