#include<stdio.h>
#include<string.h>
int stringConstruction(char* s)
{
    int char_set[26] = {0};
    int unique_count = 0;
    for (int i=0; s[i]!= '\0';i++)
    {
        int index = s[i]-'a';
        if(char_set[index]==0)
        {
            char_set[index]= 1;
            unique_count++;
        }
    }
    return unique_count;
}
int main()
{
    int q;
    if(scanf("%d", &q)!= 1)
    return 0;
    while(q--)
    {
        char s[100005];
        scanf("%s", s);
        int result = stringConstruction(s);
        printf("%d\n", result);
    }
    return 0;
}
