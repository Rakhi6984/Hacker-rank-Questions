#include<stdio.h>
int main()
{
    int n;
    scanf("%d", &n);
    int s[n];
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &s[i]);
    }
    int d, m;
    scanf("%d %d", &d, &m);
    int sum = 0;
    int count = 0;
    for (int i = 0; i < m; i++)
    {
        sum += s[i];
    }
    if (sum ==d)
    {
        count++;
    }
    for (int i = m; i < n; i++)
    {
        sum = sum-s[i-m] +s[i];
        if (sum ==d)
        {
            count++;
        }                                  
    }
    printf("%d\n", count);
    return 0;
}
