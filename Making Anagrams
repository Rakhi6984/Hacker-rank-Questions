#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <math.h>

int makingAnagrams(char* s1, char* s2) {
    int count1[26] = {0};
    int count2[26] = {0};
    for (int i = 0; s1[i] != '\0'; i++) {
        count1[s1[i] - 'a']++;
    }
    for (int i = 0; s2[i] != '\0'; i++) {
        count2[s2[i] - 'a']++;
    }
    int deletions = 0;
    for (int i = 0; i < 26; i++) {
        deletions += abs(count1[i] - count2[i]);
    }
    
    return deletions;
}

int main() {
    char s1[10005];
    char s2[10005];
    
    if (scanf("%s", s1) != 1) return 0;
    if (scanf("%s", s2) != 1) return 0;
    
    printf("%d\n", makingAnagrams(s1, s2));
    
    return 0;
}
