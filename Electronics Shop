#include<stdio.h>
int main()
{
    int b, n, m;
    scanf("%d %d %d", &b, &n, &m);
     int keyboards[n], drives[m];
     for (int i = 0; i< n; i++)
     {
        scanf("%d", &keyboards[i]);
     }   
     for (int i = 0; i < m; i++)
     {
        scanf("%d", &drives[i]);
     }
     int maxcost=-1;
     for (int i = 0; i < n; i++)
     {
        for (int j = 0; j < m; j++)
        {
            int total = keyboards[i]+drives[j];
            if (total <= b && total > maxcost)
            {
                maxcost = total;
            }
        }
     }
printf("%d\n", maxcost);
}
