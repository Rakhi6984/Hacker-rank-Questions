#include<stdio.h>
#include<stdlib.h>
#include<string.h>
int compare(const void*a,const void*b)
{
    char*s1=*(char**)a;
    char*s2=*(char**)b;
    int len1=strlen(s1);
    int len2=strlen(s2);
    if(len1 != len2)
    return len1-len2;
    return strcmp(s1,s2);
}
int main()
{
    int n;
    scanf("%d",&n);
    char**arr=malloc(n*sizeof(char*));
    char temp[1000001];
    for(int i=0;i<n;i++)
    {
        scanf("%s",temp);
        arr[i]=malloc(strlen(temp)+1);
        strcpy(arr[i],temp);
    }
    qsort(arr,n,sizeof(char*),compare);
    for(int i=0;i<n;i++)
    {
    printf("%s\n",arr[i]);
    free(arr[i]);
    }
    free(arr);
    return 0;
}
