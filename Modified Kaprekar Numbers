 #include<stdio.h>
    void kaprekarNumbers(int p,int q)
    {
    int found=0;
    for(long long n=p;n<=q;n++)
    {
        long long sq=n*n;
        int digits=1;
        long long temp=n;
        while(temp>=10)
        {
            digits++;
            temp/=10;
        }
        long long power=1;
        for(int i=0;i<digits;i++)
        power*=10;
        long long left=sq/power;
        long long right=sq%power;
        if( left + right == n)
        {
           if(found) 
           printf(" ");
           printf("%lld", n);
            found=1;
        }
    }
    if(!found)
    printf("INVALID RANGE");
    }
int main()
{
    int p,q;
    scanf("%d",&p);
    scanf("%d",&q);
    kaprekarNumbers(p,q);
    return 0;
}
