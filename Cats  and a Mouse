#include<stdio.h>
#include<math.h>
const char* catAndMouse(int x, int y, int z)
{
    int d1 = abs(x - z);
    int d2 = abs(y - z);
    if (d1 < d2)
    return "Cat A";
    else if (d2 < d1)
    return "Cat B";
    else
     return "Mouse C";
}
int main(void)
{
    int q;
    scanf("%d", &q);
    while(q--)
    {
        int x, y, z;
        scanf("%d %d %d", &x, &y, &z);
        
        
        printf("%s\n", catAndMouse(x, y, z));
    }
    return 0;
}
