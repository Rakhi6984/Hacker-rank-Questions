#include<stdio.h>
#include<string.h>
int main()
{
    int q;
    scanf("%d",&q);
    char target[]="hackerrank";
    while(q--)
    {
        char s[10001];
        scanf("%s",s);
        int j=0;
        for(int i=0;s[i]!='\0';i++)
        {
            if(s[i]==target[j])
            {
                j++;
            }
        }
        if(j==strlen(target))
        printf("YES\n");
        else 
        printf("NO\n");
    }
    return 0;
}
