#include<stdio.h>
int main()
{
    int n;
    scanf("%d", &n);
    int  ranked[n];
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &ranked[i]);
    }
    int m;
    scanf("%d", &m);
    int player[m];
    for (int j = 0; j < m; j++)
    {
        scanf("%d", &player[j]);
    }
    int unique[n];
    int k = 0;
    unique[k++] = ranked[0];
    for (int  i = 1; i < n; i++)
    {
        if (ranked[i] != ranked[i - 1])
        {
            unique[k++] = ranked[i];
        }
    }
    int j = k - 1;
    for (int  i = 0; i < m; i++)
    {
        while(j >= 0 && player[i] >= unique[j])
        {
            j--;
        }
        printf("%d\n", j + 2);
    }
    return 0;
}
