#include<stdio.h>
#include<string.h>
#include<stdlib.h>
int max(int a, int b)
{
    return (a > b) ? a : b;
}
int commonChild(char* s1, char* s2)
{
    int len1 = strlen(s1);
    int len2 = strlen(s2);
    int *prev = (int*)calloc(len2 + 1, sizeof(int));
    int *curr = (int*)calloc(len2 + 1, sizeof(int));
    for(int i =1;i<=len1;i++)
    {
        for(int j = 1;j<= len2;j++)
        {
            if (s1[i - 1] ==s2[j-1])
            {
                curr[j] = prev[j-1]+ 1;
            }
            else 
            {
                curr[j] = max(prev[j], curr[j-1]);
            }
        }
        int *temp = prev;
        prev = curr;
        curr = temp;
    }
    int result = prev[len2];
    free(prev);
    free(curr);
    return result;
}
int main()
{
    char s1[5001];
    char s2[5001];
    if(scanf("%s %s", s1, s2) == 2)
    {
        printf("%d\n", commonChild(s1, s2));
    }
    return 0;
}
