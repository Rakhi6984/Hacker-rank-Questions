#include<stdio.h>
int main()
{
    int t;
    scanf("%d",&t);
    while(t--)
    {
        int n;
        scanf("%d",&n);
        int a[1005];
        for(int i=0;i<n;i++)
        scanf("%d",&a[i]);
        int inv=0;
        for(int i=0;i<n;i++)
        {
            for(int j=i+1;j<n;j++)
            {
                if(a[i]>a[j])
                inv++;
            }
        }
        if(inv%2==0)
        printf("YES\n");
        else 
        printf("NO\n");
    }
    return 0;
}
