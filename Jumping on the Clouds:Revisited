#include<stdio.h>
int main()
{
    int n,k;
    scanf("%d%d",&n,&k);
    int c[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&c[i]);
    }
    int energy=100;
    int pos=0;
    do
    {
        pos=(pos+k)%n;
        energy--;
        if(c[pos]==1)
        {
            energy-=2;
        }
    }while(pos!=0);
    printf("%d",energy);
    return 0;
}    
