#include<stdio.h>
void printArray(int arr[],int n)
{
   for(int i=0;i<n;i++)
   {
   printf("%d", arr[i]);
   if(i<n-1) 
   printf(" ");
   }
   printf("\n"); 
}
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++)
    scanf("%d",&arr[i]);
    int value=arr[n-1];
    int i=n-2;
    while(i>=0 && arr[i]>value)
    {
        arr[i+1]=arr[i];
        printArray(arr,n);
        i--;
    }
    arr[i+1]=value;
    printArray(arr,n);
    return 0;
}
