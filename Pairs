#include<stdio.h>
#include<stdlib.h>
int compare(const void* a, const void* b)
{
    return (*(int*)a- *(int*)b);
}
int pairs(int k,int arr_count,int* arr)
{
    qsort(arr, arr_count, sizeof(int), compare);
    int i=0,j =1;
    int count = 0;
    while(j<arr_count)
    {
        int diff = arr[j]-arr[i];
        if(diff ==k)
        {
            count++;
            i++;
            j++;
        }
        else if(diff > k)
        {
            i++;
            if(i==j)
            {
                j++;
            }
        }
        else 
        {
            j++;
        }
    }
    return count;
}
int main()
{
    int n, k;
    if(scanf("%d %d", &n, &k)!=2)
    return 0;
    int* arr = malloc(n * sizeof(int));
    for(int i =0;i<n;i++)
    {
        scanf("%d", &arr[i]);
    }
    int result = pairs(k,n ,arr);
    printf("%d\n",result);
    free(arr);
    return 0;
}
